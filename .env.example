SECRET_KEY=change-me-to-a-random-string
DEBUG=True
# Public site name shown across the UI (defaults to "شجرة العائلة")
SITE_NAME=شجرة العائلة
# Comma-separated. Required when DEBUG=False (e.g. tree.example.com,www.tree.example.com)
ALLOWED_HOSTS=
# Comma-separated full origins for prod CSRF (e.g. https://tree.example.com)
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://familytree:familytree@localhost:5432/familytree

# --- Production only ---
# Turn on HTTPS cookies, SSL redirect, and HSTS (only once served over TLS).
SECURE_HARDENING=False
# Error tracking (optional). Needs `pip install sentry-sdk`; no-op if unset.
SENTRY_DSN=
LOG_LEVEL=INFO
